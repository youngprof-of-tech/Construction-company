---
layout: layouts/base.njk
jsonldType: post
ogType: article
---
{% from "partials/icons.njk" import icon %}
<article class="post">
  <header class="page-hero">
    <div class="container">
      <div class="post-meta" style="color:rgba(255,255,255,0.75);">
        <span class="post-tag">{{ category }}</span>
        <time datetime="{{ page.date | htmlDate }}">{{ page.date | readableDate }}</time>
      </div>
      <h1>{{ title }}</h1>
      <p class="crumbs"><a href="/">Home</a> &rsaquo; <a href="/blog/">Blog</a> &rsaquo; {{ title }}</p>
    </div>
  </header>

  <div class="section">
    <div class="container">
      {% if featuredImage %}
      <img src="{{ featuredImage }}" alt="{{ featuredImageAlt }}" style="border-radius:var(--radius-md);width:100%;max-height:460px;object-fit:cover;margin-bottom:var(--space-6);" width="1100" height="460" />
      {% endif %}
      <div class="prose">
        {{ content | safe }}
      </div>
      <p style="margin-top:var(--space-7);"><a class="text-link" href="/blog/">{{ icon('chevron-left', 14) }} Back to all articles</a></p>
    </div>
  </div>
</article>

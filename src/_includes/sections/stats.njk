{% set stats = home.stats %}
{% if stats and stats.length %}
<section class="section stats" aria-label="By the numbers">
  <div class="container">
    <div class="stats__grid reveal">
      {% for s in stats %}
      <div class="stat">
        <span class="stat__num"><span data-count="{{ s.value }}">0</span><span class="suffix">{{ s.suffix }}</span></span>
        <span class="stat__label">{{ s.label }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% from "partials/icons.njk" import icon %}
{% set s = home.servicesSection %}
<section class="section section--light" id="services" aria-label="Our services">
  <div class="container">
    <div class="services__head reveal">
      <div>
        {% if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
        <h2 class="section-heading">{{ s.heading }}</h2>
      </div>
      <div class="services__head-cta">
        {% if s.intro %}<p class="lead">{{ s.intro }}</p>{% endif %}
        <a class="btn btn--accent" href="{{ s.ctaUrl }}">{{ s.ctaLabel }} <span class="btn__icon">{{ icon('arrow-right', 14) }}</span></a>
      </div>
    </div>

    <div class="services__stage reveal">
      <div class="services__stage-bg">
        <img src="{{ s.backgroundImage }}" alt="{{ s.backgroundAlt }}" loading="lazy" width="1200" height="520" />
      </div>
      <div class="services__cards">
        {% for c in s.cards %}
        <article class="service-card">
          <span class="service-card__icon">{{ icon(c.icon, 24) }}</span>
          <h3>{{ c.title }}</h3>
          <ul class="service-card__list">
            {% for item in c.items %}<li>{{ icon('check', 14) }} {{ item }}</li>{% endfor %}
          </ul>
          <a class="service-card__link" href="{{ c.linkUrl or s.ctaUrl }}">{{ c.linkLabel }} {{ icon('arrow-right', 14) }}</a>
        </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

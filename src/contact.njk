---
layout: layouts/base.njk
title: Contact
permalink: /contact/
seo:
  description: "Get in touch with Industryflow for a free quote on your manufacturing, construction, or industrial project."
---
{% from "partials/icons.njk" import icon %}
<section class="page-hero">
  <div class="container">
    <h1>{{ title }}</h1>
    <p class="crumbs"><a href="/">Home</a> &rsaquo; {{ title }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="about__grid" style="align-items:start;">
      <div class="reveal">
        <span class="eyebrow">Get in touch</span>
        <h2 class="section-heading">Let's build something together</h2>
        <p class="about__body">Tell us about your project and our team will get back to you within one business day.</p>
        <ul style="display:grid;gap:var(--space-4);margin-top:var(--space-5);">
          {% if settings.contact.phone %}<li><a class="text-link" href="tel:{{ settings.contact.phone | replace(' ', '') }}">{{ icon('phone',18) }} {{ settings.contact.phone }}</a></li>{% endif %}
          {% if settings.contact.email %}<li><a class="text-link" href="mailto:{{ settings.contact.email }}">{{ icon('mail',18) }} {{ settings.contact.email }}</a></li>{% endif %}
          {% if settings.contact.address %}<li style="display:flex;gap:var(--space-2);color:var(--color-body);">{{ icon('pin',18) }} {{ settings.contact.address }}</li>{% endif %}
        </ul>
      </div>

      {# To go live with Netlify Forms: add data-netlify="true" to this form. #}
      <form class="form form--card reveal" name="contact" method="POST" action="/thank-you/" data-validate novalidate>
        <input type="hidden" name="form-name" value="contact" />
        <p class="visually-hidden" aria-hidden="true"><label>Leave blank: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="form__row">
          <div class="field">
            <label for="c-name">Name</label>
            <input id="c-name" name="name" type="text" placeholder="Your full name" data-required autocomplete="name" />
            <span class="field__error" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="c-email">Email</label>
            <input id="c-email" name="email" type="email" placeholder="you@company.com" data-required autocomplete="email" />
            <span class="field__error" aria-live="polite"></span>
          </div>
        </div>
        <div class="field">
          <label for="c-service">Service</label>
          <select id="c-service" name="service" data-required>
            <option value="">Select a service…</option>
            {% for opt in home.ctaBanner.serviceOptions %}<option value="{{ opt }}">{{ opt }}</option>{% endfor %}
          </select>
          <span class="field__error" aria-live="polite"></span>
        </div>
        <div class="field">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" rows="4" placeholder="Tell us a little about your project…" data-required></textarea>
          <span class="field__error" aria-live="polite"></span>
        </div>
        <button type="submit" class="btn btn--accent" disabled>Send Message <span class="btn__icon">{{ icon('arrow-right', 14) }}</span></button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

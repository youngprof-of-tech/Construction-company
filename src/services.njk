---
layout: layouts/base.njk
title: Services
permalink: /services/
seo:
  description: "Explore Industryflow's services — solar energy, automotive, construction, and aviation — tailored solutions engineered for industry growth."
---
{% from "partials/icons.njk" import icon %}
<section class="page-hero">
  <div class="container">
    <h1>{{ title }}</h1>
    <p class="crumbs"><a href="/">Home</a> &rsaquo; {{ title }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="reveal" style="max-width:640px;margin-bottom:var(--space-6);">
      <span class="eyebrow">{{ home.servicesSection.eyebrow }}</span>
      <h2 class="section-heading">{{ home.servicesSection.heading }}</h2>
      <p class="lead">{{ home.servicesSection.intro }}</p>
    </div>

    {% if collections.services.length %}
    <div class="card-grid">
      {% for service in collections.services %}
      <article class="card reveal">
        {% if service.data.image %}<a href="{{ service.url }}"><img src="{{ service.data.image }}" alt="{{ service.data.imageAlt }}" loading="lazy" width="400" height="250" /></a>{% endif %}
        <div class="card__body">
          <span class="mv-card__icon" style="margin-bottom:var(--space-3);">{{ icon(service.data.icon, 22) }}</span>
          <h3><a href="{{ service.url }}">{{ service.data.title }}</a></h3>
          <p>{{ service.data.excerpt }}</p>
          <a class="text-link" href="{{ service.url }}" style="margin-top:var(--space-3);">Learn more {{ icon('arrow-right', 14) }}</a>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    {# Fallback to the home services cards if no service pages exist yet. #}
    <div class="card-grid">
      {% for c in home.servicesSection.cards %}
      <article class="card reveal">
        <div class="card__body">
          <span class="mv-card__icon" style="margin-bottom:var(--space-3);">{{ icon(c.icon, 22) }}</span>
          <h3>{{ c.title }}</h3>
          <ul class="service-card__list" style="margin-top:var(--space-2);">
            {% for item in c.items %}<li style="color:var(--color-body);">{{ icon('check', 14) }} {{ item }}</li>{% endfor %}
          </ul>
        </div>
      </article>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

{% include "sections/cta.njk" %}

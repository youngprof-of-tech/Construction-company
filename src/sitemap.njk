---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set staticUrls = ["/", "/about/", "/services/", "/blog/", "/contact/"] %}
{%- for url in staticUrls %}
  <url>
    <loc>{{ url | absoluteUrl(settings.url) }}</loc>
    <changefreq>weekly</changefreq>
  </url>
{%- endfor %}
{%- for post in collections.posts %}
  <url>
    <loc>{{ post.url | absoluteUrl(settings.url) }}</loc>
    <lastmod>{{ post.date | htmlDate }}</lastmod>
    <changefreq>monthly</changefreq>
  </url>
{%- endfor %}
{%- for service in collections.services %}
  <url>
    <loc>{{ service.url | absoluteUrl(settings.url) }}</loc>
    <changefreq>monthly</changefreq>
  </url>
{%- endfor %}
</urlset>
